{
  "name": "the-masonry",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "GALLERY",
      "bucket_name": "the-masonry",
      "remote": true
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "the-masonry-gallery-events",
        "max_batch_size": 10
      }
    ]
  },
  "routes": [
    {
      "pattern": "brockshaffer.dev",
      "custom_domain": true
    }
  ]
}
