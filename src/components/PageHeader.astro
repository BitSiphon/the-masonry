---
interface Props {
    index: string;
    kicker: string;
    title: string;
    meta?: string;
}

const { index, kicker, title, meta } = Astro.props;
---

<header class="page-head">
    <p class="label">
        <span class="idx">{index}</span> {kicker}
    </p>
    <h1 class="page-head__title">{title}</h1>
    {meta && <p class="page-head__meta">{meta}</p>}
</header>

<style>
    .page-head {
        padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 4vw, 2.5rem);
        border-bottom: 1px solid var(--line);
    }

    .page-head__title {
        margin-top: 1rem;
        font-size: clamp(2.4rem, 8vw, 5.5rem);
        color: var(--text);
    }

    .page-head__meta {
        margin-top: 1rem;
        font-size: 0.72rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-faint);
    }
</style>
