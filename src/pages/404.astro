---
import Base from "@/layouts/Base.astro";
---

<Base title="Not found" description="Page not found.">
    <div class="wrap section">
        <div class="panel nf">
            <p class="label"><span class="idx">404</span> Error</p>
            <h1 class="nf__title">NOT FOUND</h1>
            <p class="nf__body">This page does not exist.</p>
            <a class="btn" href="/">Home</a>
        </div>
    </div>
</Base>

<style>
    .nf {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 2rem;
        margin-top: 2rem;
    }

    .nf__title {
        font-size: clamp(2.5rem, 10vw, 6rem);
    }

    .nf__body {
        font-size: 0.9rem;
    }

    .nf .btn {
        align-self: flex-start;
    }
</style>
