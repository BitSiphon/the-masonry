---
import PageHeader from "@/components/PageHeader.astro";
import ImageFormatConverter from "@/components/scripts/ImageFormatConverter.astro";
import Base from "@/layouts/Base.astro";
---

<Base
    title="Image Format Converter"
    description="Convert your images to PNG, JPEG, or WebP format, including HEIC and HEIF."
>
    <div class="wrap">
        <PageHeader
            index="06"
            kicker="Tools"
            title="Image Converter"
            meta="PNG / JPEG / WebP / HEIC"
        />
    </div>

    <div class="wrap section">
        <ImageFormatConverter />
    </div>
</Base>
