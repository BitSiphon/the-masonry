---
import PageHeader from "@/components/PageHeader.astro";
import ContactSheetCreator from "@/components/scripts/ContactSheetCreator.astro";
import Base from "@/layouts/Base.astro";
---

<Base
    title="Contact Sheet Creator"
    description="Generate a 4x3 contact sheet from up to 12 images."
>
    <div class="wrap">
        <PageHeader
            index="07"
            kicker="Tools"
            title="Contact Sheet"
            meta="4 x 3 / up to 12 images"
        />
    </div>

    <div class="wrap section">
        <ContactSheetCreator />
    </div>
</Base>
