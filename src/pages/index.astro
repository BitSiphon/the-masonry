---
import { env } from "cloudflare:workers";
import { site } from "@/data/site";
import Base from "@/layouts/Base.astro";
import { type GalleryBucket, getPhotos, isLocalHost } from "@/lib/gallery";
import { imageUrl, srcset } from "@/lib/images";

const bucket = env.GALLERY as GalleryBucket;
const photos = await getPhotos(bucket, { fresh: isLocalHost(Astro.url.hostname) });

const heroKey = site.heroImageKey;
const drone = photos.find((i) => i.id.includes("DJI")) ?? photos[0];
const featured = photos.slice(0, 6);
const banner = featured[0];
const grid = featured.slice(1);

const specs = [
    ["WORK", "Developer · Drone pilot · Photographer"],
    ["MAJOR", "Electrical and computer engineering"],
    ["SCHOOL", "The Ohio State University"],
    ["LOCATION", "Columbus, Ohio"],
];
---

<Base
    title="Home"
    description="Brock Shaffer, electrical and computer engineering student, drone pilot, and photographer."
>
    <section class="hero">
        <div class="wrap hero__inner">
            <div class="hero__body">
                <p class="label"><span class="idx">00</span> Portfolio</p>
                <h1 class="hero__name">
                    BROCK<br />SHAFFER
                </h1>

                <div class="hero__actions">
                    <a class="btn btn--primary" href="/gallery">Gallery</a>
                    <a class="btn btn--ghost" href="/resume.pdf" download>
                        Resume
                    </a>
                    <a
                        class="btn btn--ghost"
                        href={site.github}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        GitHub
                    </a>
                </div>

                <dl class="hero__spec">
                    {
                        specs.map(([k, v]) => (
                            <div class="hero__spec-row">
                                <dt>{k}</dt>
                                <dd>{v}</dd>
                            </div>
                        ))
                    }
                </dl>
            </div>

            <figure class="hero__fig">
                <div class="hero__frame">
                    <img
                        src={imageUrl(heroKey, {
                            width: 1200,
                            format: "auto",
                            quality: "high",
                        })}
                        srcset={srcset(heroKey, [800, 1200, 1600, 2000], {
                            format: "auto",
                            quality: "high",
                        })}
                        sizes="(max-width: 899px) 100vw, 55vw"
                        alt="Portrait of Brock Shaffer"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                    />
                </div>
                <figcaption class="hero__cap">
                    <span class="yellow">PORTRAIT</span>
                    <span>JPEG</span>
                </figcaption>
            </figure>
        </div>
    </section>

    {
        photos.length > 0 && (
            <section class="wrap section" id="photos">
                <div class="section__head">
                    <p class="label">
                        <span class="idx">01</span> Photography
                    </p>
                    <a
                        class="btn btn--ghost"
                        href="/gallery"
                        data-astro-prefetch="false"
                    >
                        All photos
                    </a>
                </div>
                <div class="strip">
                    <a
                        class="strip__item strip__item--banner"
                        href={`/gallery/${banner.id}`}
                        style="--reveal-delay: 0ms"
                    >
                        <img
                            src={imageUrl(banner.key, {
                                width: 1400,
                                format: "auto",
                                quality: "medium-high",
                            })}
                            srcset={srcset(banner.key, [640, 960, 1400], {
                                format: "auto",
                                quality: "medium-high",
                            })}
                            sizes="(max-width: 640px) 100vw, 100vw"
                            alt={banner.id}
                            loading="lazy"
                            decoding="async"
                        />
                        <span class="strip__idx">01</span>
                    </a>

                    {grid.map((p, i) => (
                        <a
                            class="strip__item"
                            href={`/gallery/${p.id}`}
                            style={`--reveal-delay: ${(i + 1) * 60}ms`}
                        >
                            <img
                                src={imageUrl(p.key, {
                                    width: 480,
                                    height: 360,
                                    fit: "cover",
                                    gravity: "auto",
                                    format: "auto",
                                    quality: "medium-low",
                                })}
                                srcset={srcset(p.key, [320, 480, 720], {
                                    height: 360,
                                    fit: "cover",
                                    gravity: "auto",
                                    format: "auto",
                                    quality: "medium-low",
                                })}
                                sizes="(max-width: 640px) 50vw, 33vw"
                                alt={p.id}
                                loading="lazy"
                                decoding="async"
                            />
                            <span class="strip__idx">
                                {String(i + 2).padStart(2, "0")}
                            </span>
                        </a>
                    ))}

                    <a
                        class="strip__item strip__item--more"
                        href="/gallery"
                        data-astro-prefetch="false"
                        style="--reveal-delay: 360ms"
                    >
                        <span>All photos</span>
                        <span>→</span>
                    </a>
                </div>
            </section>
        )
    }

    {
        drone && (
            <section class="wrap section" id="drones">
                <div class="panel drone">
                    <figure class="drone__img">
                        <img
                            src={imageUrl(drone.key, {
                                width: 1200,
                                format: "auto",
                                quality: "medium-high",
                            })}
                            alt="Drone photograph"
                            loading="lazy"
                            decoding="async"
                        />
                    </figure>
                    <div class="drone__body">
                        <p class="label">
                            <span class="idx">02</span> Drones
                        </p>
                        <h2>DRONES</h2>
                        <p>
                            I fly to capture places from angles you can't walk
                            to. Most of the time I'm waiting: for rain to stop,
                            for the light to drop, for a street to empty out.
                            Then I hold the aircraft still and let the scene do
                            the rest.
                        </p>
                        <ul class="drone__list">
                            <li>Photos</li>
                            <li>Video</li>
                        </ul>
                        <a class="btn" href="/gallery">
                            View photos
                        </a>
                    </div>
                </div>
            </section>
        )
    }
</Base>

<style>
    .hero {
        border-bottom: 1px solid var(--line);
    }

    .hero__inner {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
    }

    .hero__name {
        margin-top: 1rem;
        font-size: clamp(3rem, 13vw, 9rem);
        letter-spacing: -0.02em;
        line-height: 0.9;
    }

    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.75rem;
    }

    .hero__spec {
        margin-top: 2rem;
        border-top: 1px solid var(--line-strong);
        max-width: 34rem;
    }

    .hero__spec-row {
        display: grid;
        grid-template-columns: 7rem 1fr;
        gap: 1rem;
        padding-block: 0.5rem;
        border-bottom: 1px solid var(--line);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
    }

    .hero__spec-row dt {
        color: var(--text-faint);
    }

    .hero__spec-row dd {
        color: var(--text);
        text-transform: uppercase;
    }

    .hero__fig {
        margin: 0;
    }

    .hero__frame {
        position: relative;
        border: 1px solid var(--line-strong);
        background: var(--bg-deep);
        padding: 0.5rem;
    }

    .hero__frame::before,
    .hero__frame::after {
        content: "";
        position: absolute;
        width: 16px;
        height: 16px;
        z-index: 1;
    }

    .hero__frame::before {
        top: -1px;
        left: -1px;
        border-top: 2px solid var(--yellow);
        border-left: 2px solid var(--yellow);
    }

    .hero__frame::after {
        bottom: -1px;
        right: -1px;
        border-bottom: 2px solid var(--yellow);
        border-right: 2px solid var(--yellow);
    }

    .hero__frame img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
    }

    .hero__cap {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.5rem;
        font-size: 0.62rem;
        letter-spacing: 0.18em;
        color: var(--text-faint);
        text-transform: uppercase;
    }

    .section__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .strip {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }

    .strip__item {
        position: relative;
        overflow: hidden;
        background: var(--bg-deep);
        border: 1px solid var(--line-strong);
        aspect-ratio: 4 / 3;
        transition:
            opacity 0.5s ease var(--reveal-delay, 0ms),
            transform 0.5s ease var(--reveal-delay, 0ms),
            background-color 0.15s ease,
            color 0.15s ease;
    }

    .strip__item--banner {
        grid-column: 1 / -1;
        aspect-ratio: 16 / 8;
    }

    .strip__item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.25s ease;
    }

    .strip__item:hover img {
        transform: scale(1.03);
    }

    .strip__idx {
        position: absolute;
        bottom: 0.4rem;
        left: 0.4rem;
        padding: 0.2rem 0.4rem;
        background: var(--bg-deep);
        border: 1px solid var(--line);
        font-size: 0.6rem;
        letter-spacing: 0.1em;
        color: var(--yellow);
    }

    .strip__item--more {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-dim);
        aspect-ratio: auto;
    }

    .strip__item--more:hover {
        color: var(--hi);
        background: var(--panel-2);
    }

    .drone {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 1.5rem;
    }

    .drone__img img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border: 1px solid var(--line);
    }

    .drone__body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .drone__body h2 {
        font-size: clamp(1.6rem, 4vw, 2.6rem);
    }

    .drone__list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        color: var(--text-dim);
    }

    .drone__list li::before {
        content: "▸ ";
        color: var(--yellow);
    }

    .drone__body .btn {
        align-self: flex-start;
        margin-top: auto;
    }

    /* reveal on scroll, only when JS is available */
    :global(.js) .strip__item {
        opacity: 0;
        transform: translateY(16px);
    }

    :global(.js) .strip__item.in {
        opacity: 1;
        transform: none;
    }

    @media (min-width: 640px) {
        .strip {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (min-width: 900px) {
        .hero__inner {
            grid-template-columns: 1.1fr 1fr;
            gap: 3rem;
            align-items: center;
        }

        .hero__name {
            font-size: clamp(3.5rem, 6.5vw, 6.25rem);
        }

        .hero__frame img {
            aspect-ratio: 4 / 5;
        }

        .drone {
            grid-template-columns: 1fr 1fr;
            align-items: stretch;
        }

        .drone__img img {
            height: 100%;
            aspect-ratio: auto;
        }
    }
</style>

<script>
    const items = document.querySelectorAll(".strip__item");
    if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
            (entries) => {
                entries.forEach((e) => {
                    if (e.isIntersecting) {
                        e.target.classList.add("in");
                        io.unobserve(e.target);
                    }
                });
            },
            { threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
    } else {
        items.forEach((el) => el.classList.add("in"));
    }
</script>
